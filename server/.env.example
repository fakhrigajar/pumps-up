# Copy this file to .env and fill in the real values. .env is gitignored —
# never commit real credentials.

# Atlas requires a database name before the "?" — without one, MongoDB
# silently writes everything into a database called "test". If the password
# itself contains any of  @ : / ? # [ ]  it must be percent-encoded or the
# connection string will not parse.
MONGODB_URI=mongodb+srv://<user>:<db_password>@pumpsup.bidj0dt.mongodb.net/pumpsup?appName=PumpsUp

# A long random string used to sign session tokens. Generate one with:
#   openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-string

# 5000 conflicts with macOS's AirPlay Receiver (ControlCenter) on many Macs —
# 4000 avoids that common gotcha.
PORT=4000
NODE_ENV=development
COOKIE_NAME=pumpsup_token
